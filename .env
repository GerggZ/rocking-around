# Committed on purpose: everything here is public. Every VITE_ value is built
# into the website, so only put public values here (client IDs).
# Secrets never go in this file; they belong in the hosting provider's settings.

# Public Spotify app ID used by the browser login (PKCE).
VITE_SPOTIFY_CLIENT_ID=82eeae9401364e56b2ca10cbd0b291f8

# Public TIDAL app ID used by the browser login (PKCE).
VITE_TIDAL_CLIENT_ID=LvGUYsMTyIdFrQpl

# TIDAL audio relay. Local dev serves /api/tidal/audio automatically.
# For GitHub Pages, set this to the hosted relay's HTTPS /api/tidal/audio URL before building.
# VITE_TIDAL_AUDIO_PROXY_URL=

# Server-side only (npm run start:tidal): website origins allowed to use the relay.
# TIDAL_ALLOWED_ORIGINS=https://gerggz.github.io
